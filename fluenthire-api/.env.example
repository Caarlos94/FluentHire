# FluentHire API - Environment Variables
# Copy this file to .env and fill in your values

# AI APIs
CLAUDE_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# Email (Resend)
RESEND_API_KEY=re_your-key-here
RESEND_FROM_EMAIL=support@mail.fluenthire.app

# CORS & App URL
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Payments (Stripe)
STRIPE_API_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here
STRIPE_PRICE_STARTER=price_test_starter
STRIPE_PRICE_PRO=price_test_pro
STRIPE_PRICE_INTENSIVE=price_test_intensive
STRIPE_PRICE_PACK_3=price_test_pack_3
STRIPE_PRICE_PACK_6=price_test_pack_6
STRIPE_PRICE_PACK_10=price_test_pack_10

# Auth
JWT_SECRET=generate-a-64-char-random-string-at-least-256-bits

# Database
DB_PASSWORD=your-db-password
